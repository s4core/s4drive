{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram/main/docs/tauri-conf.schema.json",
  "productName": "S4Drive",
  "version": "0.1.0",
  "identifier": "com.s4drive.app",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "S4Drive",
        "label": "main",
        "width": 500,
        "height": 600,
        "minWidth": 380,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.svg"
    ]
  }
}

